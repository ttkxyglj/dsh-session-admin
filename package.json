{
  "name": "@local/dsh-session-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Permanently delete Harness sessions and the files they stored, from the sidebar session menu or from the agent.",
  "license": "MIT",
  "author": "Erji Gao",
  "repository": {
    "type": "git",
    "url": "https://github.com/ttkxyglj/dsh-session-admin.git"
  },
  "homepage": "https://github.com/ttkxyglj/dsh-session-admin#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-management",
    "cleanup"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
